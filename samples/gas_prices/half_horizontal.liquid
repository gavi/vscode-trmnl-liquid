{% assign reg = rows | where: "fuel", "unleaded" | first %}
{% assign diesel = rows | where: "fuel", "diesel" | first %}

<div class="layout layout--col gap--distribute">
  <div class="grid grid--cols-2">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--tnums value--large">${{ reg.state }}</span>
        <span class="label">Regular · {{ state }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--tnums value--large">${{ reg.national }}</span>
        <span class="label">Regular · US</span>
      </div>
    </div>
  </div>
  <div class="divider"></div>
  <div class="grid grid--cols-2">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--tnums value--small">{% if reg.diff >= 0 %}+{% endif %}${{ reg.diff }}</span>
        <span class="label">{{ state }} vs US</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--tnums value--small">${{ diesel.state }}</span>
        <span class="label">Diesel · {{ state }} (US ${{ diesel.national }})</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="https://usetrmnl.com/images/plugins/trmnl--render.svg">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">{{ state }} · AAA</span>
</div>
