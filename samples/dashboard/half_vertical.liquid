<div class="layout layout--col gap--space-between">
  <div class="item">
    <div class="meta"></div>
    <div class="content">
      <span class="value value--tnums value--xxlarge" data-value-fit="true">{{ summary.enrollment }}</span>
      <span class="label">{{ term }} Enrollment</span>
    </div>
  </div>
  <div class="divider"></div>
  <div class="item">
    <div class="meta"></div>
    <div class="content flex flex--row flex--left gap--small">
      <span class="value value--tnums value--large">{% if summary.enrl_up %}▲{% else %}▼{% endif %} {{ summary.enrl_chg_pct }}%</span>
      <span class="label">vs {{ compared_to }}</span>
    </div>
  </div>
  <div class="divider"></div>
  <div class="grid grid--cols-2">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--tnums value--small">{{ summary.credits }}</span>
        <span class="label">{{ term }} credits</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--tnums value--small">{% if summary.crd_up %}▲{% else %}▼{% endif %} {{ summary.crd_chg_pct }}%</span>
        <span class="label">vs {{ compared_to }}</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="https://usetrmnl.com/images/plugins/trmnl--render.svg">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">{{ term }}</span>
</div>
