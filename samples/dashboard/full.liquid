<div class="layout layout--col gap--space-between">
  <div class="grid">
    <div class="item col--span-6">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xxlarge value--tnums" data-value-fit="true">{{ summary.enrollment }}</span>
        <span class="label">{{ term }} Enrollment · {% if summary.enrl_up %}▲{% else %}▼{% endif %} {{ summary.enrl_chg_pct }}% vs {{ compared_to }}</span>
      </div>
    </div>

    <div class="col col--span-3 gap--medium">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--medium value--tnums">{{ summary.credits }}</span>
          <span class="label">Credits · {% if summary.crd_up %}▲{% else %}▼{% endif %} {{ summary.crd_chg_pct }}%</span>
        </div>
      </div>
      <div class="divider"></div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--small value--tnums">{{ summary.enrollment_prev }} / {{ summary.credits_prev }}</span>
          <span class="label">{{ compared_to }} enrl. / cred.</span>
        </div>
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <table class="table">
    <thead>
      <tr><th>Career</th><th class="text--right">Enrl</th><th class="text--right">Δ%</th><th class="text--right">Cred</th><th class="text--right">Δ%</th></tr>
    </thead>
    <tbody>
      {% for r in rows %}
      <tr>
        <td>{{ r.career }}</td>
        <td class="text--right value--tnums">{{ r.enrollment }}</td>
        <td class="text--right value--tnums">{% if r.enrl_up %}▲{% else %}▼{% endif %} {{ r.enrl_chg_pct }}</td>
        <td class="text--right value--tnums">{{ r.credits }}</td>
        <td class="text--right value--tnums">{% if r.crd_up %}▲{% else %}▼{% endif %} {{ r.crd_chg_pct }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<div class="title_bar">
  <img class="image" src="https://usetrmnl.com/images/plugins/trmnl--render.svg">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">{{ term }} · LIU Dashboard</span>
</div>
