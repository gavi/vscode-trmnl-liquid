<div class="layout layout--col gap--space-between">
  <div class="grid">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--large value--tnums" data-value-fit="true">{{ summary.enrollment }}</span>
        <span class="label">{{ term }} Enrollment</span>
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <div class="grid" style="gap: 9px;">
    <div class="item col--span-7">
      <div class="meta"></div>
      <div class="content flex flex--row flex--left gap--small">
        <span class="value value--tnums">{% if summary.enrl_up %}▲{% else %}▼{% endif %} {{ summary.enrl_chg_pct }}%</span>
        <span class="label">vs {{ compared_to }}</span>
      </div>
    </div>

    <div class="col col--span-5 gap--small">
      <div class="item">
        <div class="meta"></div>
        <div class="content flex flex--row flex--left gap--small">
          <span class="value value--tnums value--xsmall">{{ summary.credits }}</span>
          <span class="label">credits</span>
        </div>
      </div>

      <div class="divider"></div>

      <div class="item">
        <div class="meta"></div>
        <div class="content flex flex--row flex--left gap--small">
          <span class="value value--tnums value--xsmall">{% if summary.crd_up %}▲{% else %}▼{% endif %} {{ summary.crd_chg_pct }}%</span>
          <span class="label">vs {{ compared_to }}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="https://usetrmnl.com/images/plugins/trmnl--render.svg">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">{{ term }}</span>
</div>
